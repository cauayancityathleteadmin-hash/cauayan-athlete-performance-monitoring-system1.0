generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  coach
}

enum UserStatus {
  pending
  active
  inactive
  rejected
}

enum ActiveStatus {
  active
  inactive
}

enum AthleteGender {
  male
  female
  other
  prefer_not_to_say
}

enum MetricDataType {
  decimal
  integer
  text
}

enum BetterDirection {
  higher
  lower
  neutral
}

enum EventPlanStatus {
  draft
  open
  closed
  cancelled
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum ParticipantType {
  coach
  athlete
}

enum ParticipantStatus {
  active
  removed
}

enum HealthStatus {
  healthy
  sick
  injured
  recovering
  inactive
}

enum TrainingSessionType {
  regular
  conditioning
  technical
  tactical
  recovery
  competition_simulation
  tryout
}

enum ExerciseCategory {
  warmup
  mobility
  strength
  power
  speed_agility
  endurance
  skill_technique
  tactical
  cooldown
  recovery
}

enum AttendanceStatus {
  present
  late
  excused
  absent
}

enum FitnessDimension {
  endurance
  strength
  power
  speed_agility
  skill_technique
  mobility
  recovery
}

enum ActivityStatus {
  planned
  done
  partial
  missed
}

model User {
  id                    Int                    @id @default(autoincrement())
  username              String?                @unique
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  role                  UserRole
  status                UserStatus             @default(pending)
  mustChangePassword    Boolean                @default(true) @map("must_change_password")
  passwordChangedAt     DateTime?              @map("password_changed_at")
  lastLoginAt           DateTime?              @map("last_login_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  coach                 Coach?
  assessments           Assessment[]
  auditLogs             AuditLog[]
  eventPlans            EventPlan[]
  assignedCoachHistory  AthleteCoachHistory[]  @relation("HistoryAssigner")
  changedStatusHistory  AthleteStatusHistory[] @relation("StatusChanger")
  reviewedApplications  EventApplication[]     @relation("ApplicationReviewer")
  addedParticipants     EventParticipant[]
  coachingNotes         CoachingNote[]          @relation("NoteAuthor")
  passwordResetTokens   PasswordResetToken[]
  healthLogsReported    HealthLog[]            @relation("HealthLogReporter")
  healthLogsResolved    HealthLog[]            @relation("HealthLogResolver")
  trainingPerformances  ExercisePerformance[]  @relation("PerformanceRecorder")
  coachPerformanceEvals CoachPerformance[]     @relation("CoachPerformanceEvaluator")
  trainingAssessments   TrainingAssessment[]   @relation("TrainingAssessor")
  planActivityLogs      PlanActivityLog[]      @relation("ActivityLogger")
  trainingNotesAuthored TrainingNote[]         @relation("TrainingNoteAuthor")
  @@map("users")
  @@index([role, status])
}

model RateLimitBucket {
  id        Int      @id @default(autoincrement())
  scope     String   @map("scope")
  bucketKey String   @map("bucket_key")
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@unique([scope, bucketKey])
  @@map("rate_limit_buckets")
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId])
}

model School {
  id         Int           @id @default(autoincrement())
  schoolName String        @unique @map("school_name")
  status     ActiveStatus  @default(active)
  createdAt  DateTime      @default(now()) @map("created_at")
  coaches    Coach[]
  athletes   Athlete[]
  @@map("schools")
}

model Coach {
  id                   Int          @id @default(autoincrement())
  userId               Int          @unique @map("user_id")
  coachCode            String       @unique @map("coach_code")
  firstName            String       @map("first_name")
  middleName           String?      @map("middle_name")
  lastName             String       @map("last_name")
  suffix               String?
  birthdate            DateTime
  email                String
  contactNumber        String?      @map("contact_number")
  schoolId             Int?         @map("school_id")
  status               ActiveStatus @default(active)
  dateRegistered       DateTime     @map("date_registered")
  canApproveCoaches    Boolean      @default(false) @map("can_approve_coaches")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school               School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sports               CoachSport[]
  athletes             Athlete[]
  coachHistory         AthleteCoachHistory[]
  applications         EventApplication[]
  participants         EventParticipant[]
  trainingSessions     TrainingSession[]
  performances         CoachPerformance[]
  trainingPlans        TrainingPlan[]
  @@map("coaches")
  @@index([schoolId, status])
}

model Sport {
  id          Int           @id @default(autoincrement())
  sportName   String        @unique @map("sport_name")
  description String?
  status      ActiveStatus  @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  events      Event[]
  coaches     CoachSport[]
  planSports  EventPlanSport[]
  athletes    Athlete[]
  participants EventParticipant[]
  trainingSessions TrainingSession[]
  trainingPlans    TrainingPlan[]
  @@map("sports")
}

model Event {
  id          Int          @id @default(autoincrement())
  sportId     Int          @map("sport_id")
  eventName   String       @map("event_name")
  description String?
  status      ActiveStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  sport       Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  metrics     PerformanceMetric[]
  athletes    Athlete[]
  @@unique([sportId, eventName])
  @@map("events")
  @@index([sportId, status])
}

model CoachSport {
  coachId Int @map("coach_id")
  sportId Int @map("sport_id")
  coach   Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  @@id([coachId, sportId])
  @@map("coach_sports")
}

model Athlete {
  id             Int           @id @default(autoincrement())
  athleteCode    String        @unique @map("athlete_code")
  firstName      String        @map("first_name")
  middleName     String?       @map("middle_name")
  lastName       String        @map("last_name")
  suffix         String?
  birthdate      DateTime
  gender         AthleteGender
  contactNumber  String?       @map("contact_number")
  email          String?
  address        String?
  schoolId       Int?          @map("school_id")
  sportId        Int           @map("sport_id")
  eventId        Int?          @map("event_id")
  coachId        Int           @map("coach_id")
  status         ActiveStatus  @default(active)
  dateRegistered DateTime      @map("date_registered")
  height         Decimal?      @map("height")
  weight         Decimal?      @map("weight")
  pictureUrl     String?       @map("picture_url")
  healthStatus   HealthStatus  @default(healthy) @map("health_status")
  healthNotes    String?       @map("health_notes")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sport          Sport         @relation(fields: [sportId], references: [id])
  event          Event?        @relation(fields: [eventId], references: [id])
  coach          Coach         @relation(fields: [coachId], references: [id])
  coachHistory   AthleteCoachHistory[]
  statusHistory  AthleteStatusHistory[]
  assessments    Assessment[]
  achievements   Achievement[]
  participants   EventParticipant[]
  notes          CoachingNote[]
  healthLogs     HealthLog[]
  trainingPerformances ExercisePerformance[]
  trainingAttendances TrainingAttendance[]
  trainingPlans       TrainingPlanAthlete[]
  trainingAssessments TrainingAssessment[]
  planActivityTargets PlanActivityTarget[]
  planActivityLogs    PlanActivityLog[]
  @@map("athletes")
  @@index([coachId, status])
  @@index([sportId, eventId])
}

model AthleteCoachHistory {
  id         Int       @id @default(autoincrement())
  athleteId  Int       @map("athlete_id")
  coachId    Int       @map("coach_id")
  assignedBy Int?      @map("assigned_by")
  reason     String?
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach      Coach     @relation(fields: [coachId], references: [id])
  assigner   User?     @relation("HistoryAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  @@map("athlete_coach_history")
  @@index([athleteId, startedAt])
}

model AthleteStatusHistory {
  id        Int       @id @default(autoincrement())
  athleteId Int       @map("athlete_id")
  oldStatus String?   @map("old_status")
  newStatus String    @map("new_status")
  changedBy Int?      @map("changed_by")
  reason    String?
  changedAt DateTime  @default(now()) @map("changed_at")
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  changer   User?     @relation("StatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)
  @@map("athlete_status_history")
  @@index([athleteId, changedAt])
}

model CoachingNote {
  id        Int      @id @default(autoincrement())
  athleteId Int      @map("athlete_id")
  authorId  Int?     @map("author_id")
  note      String   @map("note")
  createdAt DateTime @default(now()) @map("created_at")
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  @@map("coaching_notes")
  @@index([athleteId, createdAt])
}

model PerformanceMetric {
  id              Int             @id @default(autoincrement())
  eventId         Int             @map("event_id")
  metricName      String          @map("metric_name")
  unit            String?
  dataType        MetricDataType  @default(decimal) @map("data_type")
  betterDirection BetterDirection @default(neutral) @map("better_direction")
  decimalPlaces   Int             @default(2) @map("decimal_places")
  minimumValue    Decimal?        @map("minimum_value")
  maximumValue    Decimal?        @map("maximum_value")
  isRequired      Boolean         @default(false) @map("is_required")
  status          ActiveStatus    @default(active)
  createdAt       DateTime        @default(now()) @map("created_at")
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  results         AssessmentResult[]
  @@unique([eventId, metricName])
  @@map("performance_metrics")
}

model Assessment {
  id             Int      @id @default(autoincrement())
  athleteId      Int      @map("athlete_id")
  recordedBy     Int      @map("recorded_by")
  assessmentDate DateTime @map("assessment_date")
  assessmentType String   @default("Regular Assessment") @map("assessment_type")
  remarks        String?
  createdAt      DateTime @default(now()) @map("created_at")
  athlete        Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recorder       User     @relation(fields: [recordedBy], references: [id])
  results        AssessmentResult[]
  @@map("assessments")
  @@index([athleteId, assessmentDate])
  @@index([recordedBy, assessmentDate])
}

model AssessmentResult {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  metricId     Int      @map("metric_id")
  valueDecimal Decimal? @map("value_decimal")
  valueText    String?  @map("value_text")
  notes        String?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  metric       PerformanceMetric @relation(fields: [metricId], references: [id])
  @@unique([assessmentId, metricId])
  @@map("assessment_results")
  @@index([metricId])
}

model Achievement {
  id               Int       @id @default(autoincrement())
  athleteId        Int       @map("athlete_id")
  achievementTitle String    @map("achievement_title")
  achievementType  String?   @map("achievement_type")
  achievementDate  DateTime? @map("achievement_date")
  organization     String?
  description      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  athlete          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@map("achievements")
  @@index([athleteId, achievementDate])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    Int?     @map("entity_id")
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("audit_logs")
  @@index([userId, createdAt])
}

model EventPlan {
  id                Int             @id @default(autoincrement())
  eventName         String          @map("event_name")
  description       String?
  startDate         DateTime        @map("start_date")
  startTime         DateTime?       @map("start_time")
  endDate           DateTime?       @map("end_date")
  endTime           DateTime?       @map("end_time")
  venue             String
  status            EventPlanStatus @default(draft)
  programFlow       String?         @map("program_flow")
  targetParticipants Int?           @map("target_participants")
  purpose           String?         @map("purpose")
  targetAgeMin      Int?            @map("target_age_min")
  targetAgeMax      Int?            @map("target_age_max")
  targetGender      String?         @map("target_gender")
  createdBy         Int?            @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  creator           User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sports            EventPlanSport[]
  applications      EventApplication[]
  participants      EventParticipant[]
  @@map("event_plans")
  @@index([status, startDate])
}

model EventPlanSport {
  eventPlanId Int @map("event_plan_id")
  sportId     Int @map("sport_id")
  eventPlan   EventPlan @relation(fields: [eventPlanId], references: [id], onDelete: Cascade)
  sport       Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  @@id([eventPlanId, sportId])
  @@map("event_plan_sports")
}

model EventApplication {
  id          Int               @id @default(autoincrement())
  eventPlanId Int               @map("event_plan_id")
  coachId     Int               @map("coach_id")
  status      ApplicationStatus @default(pending)
  reason      String?
  appliedAt   DateTime          @default(now()) @map("applied_at")
  reviewedAt  DateTime?         @map("reviewed_at")
  reviewedBy  Int?              @map("reviewed_by")
  eventPlan   EventPlan         @relation(fields: [eventPlanId], references: [id], onDelete: Cascade)
  coach       Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  reviewer    User?             @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  @@unique([eventPlanId, coachId])
  @@map("event_applications")
  @@index([eventPlanId, status])
}

model EventParticipant {
  id              Int               @id @default(autoincrement())
  eventPlanId     Int               @map("event_plan_id")
  coachId         Int               @map("coach_id")
  athleteId       Int?              @map("athlete_id")
  sportId         Int               @map("sport_id")
  participantType ParticipantType    @map("participant_type")
  status          ParticipantStatus @default(active)
  addedBy         Int?              @map("added_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  eventPlan       EventPlan         @relation(fields: [eventPlanId], references: [id], onDelete: Cascade)
  coach           Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athlete         Athlete?          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport           Sport             @relation(fields: [sportId], references: [id], onDelete: Cascade)
  adder           User?             @relation(fields: [addedBy], references: [id], onDelete: SetNull)
  @@unique([eventPlanId, coachId, athleteId, sportId])
  @@map("event_participants")
  @@index([eventPlanId, athleteId])
}

model HealthLog {
  id           Int       @id @default(autoincrement())
  athleteId    Int       @map("athlete_id")
  status       HealthStatus
  description  String?
  reportedBy   Int?      @map("reported_by")
  reportedAt   DateTime  @default(now()) @map("reported_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedBy   Int?      @map("resolved_by")
  athlete      Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  reporter     User?     @relation("HealthLogReporter", fields: [reportedBy], references: [id], onDelete: SetNull)
  resolver     User?     @relation("HealthLogResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  @@map("health_logs")
  @@index([athleteId, reportedAt])
}

model TrainingSession {
  id              Int                    @id @default(autoincrement())
  sessionDate     DateTime               @map("session_date")
  startTime       DateTime?              @map("start_time")
  endTime         DateTime?              @map("end_time")
  sessionType     TrainingSessionType    @default(regular) @map("session_type")
  sportId         Int                    @map("sport_id")
  coachId         Int                    @map("coach_id")
  venue           String?
  notes           String?
  planId          Int?                   @map("plan_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  sport           Sport                  @relation(fields: [sportId], references: [id])
  coach           Coach                  @relation(fields: [coachId], references: [id])
  plan            TrainingPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  exercises       TrainingExercise[]
  attendances     TrainingAttendance[]
  assessments     TrainingAssessment[]
  @@map("training_sessions")
  @@index([coachId, sessionDate])
  @@index([sportId, sessionDate])
  @@index([planId])
}

model TrainingExercise {
  id               Int                @id @default(autoincrement())
  sessionId        Int                @map("session_id")
  exerciseName     String             @map("exercise_name")
  category         ExerciseCategory
  description      String?
  orderIndex       Int                @default(0) @map("order_index")
  targetSets       Int?               @map("target_sets")
  targetReps       Int?               @map("target_reps")
  targetDuration   Int?               @map("target_duration")
  targetLoad       Decimal?           @map("target_load")
  targetDistance   Decimal?           @map("target_distance")
  targetHeartRate  Int?               @map("target_heart_rate")
  equipment        String?
  createdAt        DateTime           @default(now()) @map("created_at")
  session          TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  performances     ExercisePerformance[]
  @@map("training_exercises")
  @@index([sessionId, orderIndex])
}

model ExercisePerformance {
  id               Int                @id @default(autoincrement())
  exerciseId       Int                @map("exercise_id")
  athleteId        Int                @map("athlete_id")
  attendanceId     Int?               @map("attendance_id")
  setsCompleted    Int?               @map("sets_completed")
  repsCompleted    Int?               @map("reps_completed")
  durationSec      Int?               @map("duration_sec")
  loadUsed         Decimal?           @map("load_used")
  distanceCovered  Decimal?           @map("distance_covered")
  heartRateAvg     Int?               @map("heart_rate_avg")
  heartRateMax     Int?               @map("heart_rate_max")
  rpe              Int?               @map("rpe")
  score            Decimal?           @map("score")
  scoreBreakdown   Json?              @map("score_breakdown")
  notes            String?
  recordedBy       Int                @map("recorded_by")
  recordedAt       DateTime           @default(now()) @map("recorded_at")
  exercise         TrainingExercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  athlete          Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  attendance       TrainingAttendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  recorder         User               @relation("PerformanceRecorder", fields: [recordedBy], references: [id])
  @@unique([exerciseId, athleteId])
  @@map("exercise_performances")
  @@index([athleteId, recordedAt])
}

model TrainingAttendance {
  id            Int       @id @default(autoincrement())
  sessionId     Int       @map("session_id")
  athleteId     Int       @map("athlete_id")
  status        AttendanceStatus @default(present)
  checkInTime   DateTime? @map("check_in_time")
  checkOutTime  DateTime? @map("check_out_time")
  notes         String?
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete       Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  performances  ExercisePerformance[]
  @@unique([sessionId, athleteId])
  @@map("training_attendances")
}

model TrainingPlan {
  id          Int                    @id @default(autoincrement())
  planName    String                 @map("plan_name")
  description String?
  sportId     Int                    @map("sport_id")
  coachId     Int                    @map("coach_id")
  frequency   String                 @default("day") @map("frequency")
  startDate   DateTime               @map("start_date")
  endDate     DateTime?              @map("end_date")
  status      String                 @default("active") @map("status")
  isTemplate  Boolean                @default(false) @map("is_template")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  sport       Sport                  @relation(fields: [sportId], references: [id])
  coach       Coach                  @relation(fields: [coachId], references: [id])
  athletes    TrainingPlanAthlete[]
  assessments TrainingAssessment[]
  sessions    TrainingSession[]
  activities  PlanActivity[]
  notes       TrainingNote[]
  @@map("training_plans")
  @@index([coachId, startDate])
  @@index([sportId, startDate])
  @@index([isTemplate])
}

model TrainingPlanAthlete {
  id        Int      @id @default(autoincrement())
  planId    Int      @map("plan_id")
  athleteId Int      @map("athlete_id")
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([planId, athleteId])
  @@map("training_plan_athletes")
  @@index([athleteId])
}

model PlanActivity {
  id             Int             @id @default(autoincrement())
  planId         Int             @map("plan_id")
  activityName   String          @map("activity_name")
  fitnessType    FitnessDimension @map("fitness_type")
  targetQuantity Decimal?        @map("target_quantity")
  targetUnit     String?         @map("target_unit")
  targetSets     Int?            @map("target_sets")
  targetReps     Int?            @map("target_reps")
  targetDistance Decimal?        @map("target_distance")
  targetLoad     Decimal?        @map("target_load")
  instructions   String?
  orderIndex     Int             @default(0) @map("order_index")
  createdAt      DateTime        @default(now()) @map("created_at")
  plan           TrainingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  targets        PlanActivityTarget[]
  logs           PlanActivityLog[]
  @@map("plan_activities")
  @@index([planId, orderIndex])
}

model PlanActivityTarget {
  id              Int         @id @default(autoincrement())
  activityId      Int         @map("activity_id")
  athleteId       Int         @map("athlete_id")
  targetQuantity Decimal?    @map("target_quantity")
  targetUnit      String?     @map("target_unit")
  targetSets      Int?        @map("target_sets")
  targetReps      Int?        @map("target_reps")
  targetDistance  Decimal?    @map("target_distance")
  targetLoad      Decimal?    @map("target_load")
  note            String?
  activity        PlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  athlete         Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([activityId, athleteId])
  @@map("plan_activity_targets")
  @@index([athleteId])
}

model PlanActivityLog {
  id           Int             @id @default(autoincrement())
  activityId   Int             @map("activity_id")
  athleteId    Int             @map("athlete_id")
  performedAt  DateTime        @map("performed_at")
  status       ActivityStatus  @default(planned)
  quantityDone Decimal?        @map("quantity_done")
  setsDone     Int?            @map("sets_done")
  repsDone     Int?            @map("reps_done")
  notes        String?
  loggedBy     Int             @map("logged_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  activity     PlanActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  athlete      Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  logger       User            @relation("ActivityLogger", fields: [loggedBy], references: [id])
  @@map("plan_activity_logs")
  @@index([athleteId, performedAt])
  @@index([activityId, athleteId])
}

model TrainingNote {
  id        Int       @id @default(autoincrement())
  planId    Int       @map("plan_id")
  authorId  Int       @map("author_id")
  body      String    @map("body")
  createdAt DateTime  @default(now()) @map("created_at")
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  author    User      @relation("TrainingNoteAuthor", fields: [authorId], references: [id])
  @@map("training_notes")
  @@index([planId, createdAt])
}

model TrainingAssessment {
  id              Int             @id @default(autoincrement())
  planId          Int?            @map("plan_id")
  sessionId       Int?            @map("session_id")
  athleteId       Int             @map("athlete_id")
  assessmentDate  DateTime        @default(now()) @map("assessment_date")
  rating          Int             @map("rating")
  fitnessDimension FitnessDimension? @map("fitness_dimension")
  comments        String?
  assessedBy      Int             @map("assessed_by")
  plan            TrainingPlan?   @relation(fields: [planId], references: [id], onDelete: Cascade)
  session         TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  assessor        User            @relation("TrainingAssessor", fields: [assessedBy], references: [id])
  @@map("training_assessments")
  @@index([athleteId, assessmentDate])
  @@index([planId])
}

model CoachPerformance {
  id                   Int       @id @default(autoincrement())
  coachId              Int       @map("coach_id")
  evaluatorId          Int       @map("evaluator_id")
  periodStart          DateTime  @map("period_start")
  periodEnd            DateTime  @map("period_end")
  sessionPlanning      Int       @map("session_planning")
  exerciseSelection    Int       @map("exercise_selection")
  technicalInstruction Int       @map("technical_instruction")
  athleteDevelopment   Int       @map("athlete_development")
  communication        Int
  safetyCompliance     Int       @map("safety_compliance")
  trainingImplementation Int    @default(0) @map("training_implementation")
  overallScore         Decimal   @map("overall_score")
  strengths            String?
  areasForImprovement  String?   @map("areas_for_improvement")
  actionPlan           String?   @map("action_plan")
  createdAt            DateTime  @default(now()) @map("created_at")
  coach                Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  evaluator            User      @relation("CoachPerformanceEvaluator", fields: [evaluatorId], references: [id])
  @@map("coach_performances")
  @@index([coachId, periodStart])
}